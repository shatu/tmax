# Canonical launch env for the sfgeo_parity1 8x32 sandfleet arm. Source this before
# sbatch; ad-hoc reconstructions have now dropped SWERL_APPTAINER_SIF_DIR, JOB_NAME,
# and DATASET_JSONL across restarts — every pin lives here instead.
export REPO_ROOT=/checkpoint/comem/rulin/open-instruct-geomean
export UV_PROJECT_ENVIRONMENT=/checkpoint/comem/rulin/open-instruct/.venv
export PYTHONPATH=/checkpoint/comem/rulin/open-instruct-geomean
export SWERL_SANDBOX_BACKEND=sandfleet
# SANDFLEET_URL is set by the launcher's embedded-controller block at job start
export SANDFLEET_EMBED_CONTROLLER=1
export SANDFLEET_CLIENT_TOKEN=$(cat /checkpoint/comem/rulin/sandfleet_rt/client.token)
unset SANDFLEET_POOL   # declarative resources (0.5.1 validation) — do NOT set a pool
export SWERL_SANDBOX_MEM_LIMIT=8g
export SWERL_APPTAINER_SIF_DIR=/checkpoint/comem/rulin/cache/apptainer-sifs
export DATASET_JSONL=/checkpoint/comem/rulin/vmvm_upload/swerl_tmax_15k_apptainer.jsonl
export EXP_NAME=swerl_qwen35_9b_dppo_sfgeo_parity1
export JOB_NAME=jb-${EXP_NAME}
export RUN_ID=swerl_qwen35_9b_dppo_sfgeo_parity1__seed42__20260829_175732
export NUM_UNIQUE_PROMPTS_ROLLOUT=8
export NUM_SAMPLES_PER_PROMPT_ROLLOUT=32
export TOTAL_EPISODES=128000
export SANDFLEET_SRC=/checkpoint/comem/rulin/sandfleet-f3b2dcc
# Sick-node set (3 jobs killed in 35-56m, Xid/ECC). Watchdog forwards this to every resubmit.
export EXCLUDE_NODES='h100-139-017-[213,217],h100-139-119-219,h100-139-019-104,h100-139-047-016,h100-139-085-179,h100-139-124-140,h100-139-140-150,h100-139-213-229'
